{
  "name": "service-business-repository",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-26",
  "previews": {},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "QUOTE_PAYMENT_MODE": "disabled"
  }
}
